# Copy to .env (never committed) to use an online, OpenAI-compatible model:
#   cp .env.example .env
# then set [llm] backend = "openai_compatible", or a chain such as
#   chain = ["openai_compatible", "ollama", "stub"]
# in config.toml. The key is read by the server only: it is never sent to the browser,
# shown by /api/health or written to the logs and metrics.
#
# Privacy: in online mode every question that misses the cache is sent to this provider.

SEMCACHE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
SEMCACHE_OPENAI_MODEL=llama-3.1-8b-instant
SEMCACHE_OPENAI_API_KEY=

# Other variables the project reads (optional):
# SEMCACHE_ADMIN_KEY=choose-a-passphrase
# SEMCACHE_PROFILE=faq
# SEMCACHE_LLM_BACKEND=stub
